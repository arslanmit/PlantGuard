{
  "redhat.telemetry.enabled": true,
  "vs-kubernetes": {
    "vscode-kubernetes.minikube-path-linux": "/home/codespace/.local/state/vs-kubernetes/tools/minikube/linux-amd64/minikube",
    "vscode-kubernetes.minikube-path-mac": "/Users/umitarslan/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
    "vscode-kubernetes.helm-path-mac": "/Users/umitarslan/.vs-kubernetes/tools/helm/darwin-arm64/helm"
  },
  "git.enableSmartCommit": true,
  "dart.openDevTools": "flutter",
  "geminicodeassist.inlineSuggestions.enableAuto": true,
  "github.copilot.chat.followUps": "always",
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.completionContext.typescript.mode": "on",
  "github.copilot.chat.editor.temporalContext.enabled": true,
  "github.copilot.chat.edits.temporalContext.enabled": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "github.copilot.chat.newWorkspaceCreation.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.search.semanticTextResults": true,
  "github-actions.use-enterprise": true,
  "github-actions.workflows.pinned.refresh.enabled": true,
  "github.codespaces.allowUnsafeConnections": true,
  "github.codespaces.createCodespaceInNewWindow": true,
  "github.codespaces.devcontainerChangedNotificationStyle": "modal",
  "github.codespaces.showPerformanceExplorer": true,
  "github.codespaces.supportProxies": true,
  "githubIssues.alwaysPromptForNewIssueRepo": true,
  "githubPullRequests.defaultCreateOption": "createAutoMerge",
  "githubPullRequests.experimental.chat": true,
  "githubPullRequests.experimental.useQuickChat": true,
  "githubPullRequests.experimental.notificationsView": true,
  "githubPullRequests.neverIgnoreDefaultBranch": true,
  "githubPullRequests.notifications": "pullRequests",
  "githubPullRequests.quickDiff": true,
  "githubPullRequests.showPullRequestNumberInTree": true,
  "npm.enableRunFromFolder": true,
  "npm-intellisense.scanDevDependencies": true,
  "npm-intellisense.showBuildInLibs": true,
  "npm-intellisense.packageSubfoldersIntellisense": true,
  "powershell.suppressAdditionalExeNotFoundWarning": true,
  "git.autofetch": true,
  "explorer.confirmDragAndDrop": false,
  "cloudcode.project": "retexi",
  "cloudcode.autoDependencies": "on",
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": false,
    "scminput": false
  },
  "diffEditor.codeLens": true,
  "git.confirmSync": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "@azure.argTenant": "",
  "azureResourceGroups.selectedSubscriptions": [],
  "explorer.confirmDelete": false,
  "chromiumide.metrics.showMessage": false,
  "chromiumide.metrics.collectMetrics": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "codeium.aggressiveShutdown": true,
  "codeium.enableSearch": true,
  "workbench.colorTheme": "Solarized Light",
  "snowflake.connectionsConfigFile": "/Users/umitarslan/.snowflake/connections.toml",
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "kiroAgent.enableTabAutocomplete": true,
  "kiroAgent.enableDebugLogs": true,
  "kiroAgent.trustedCommands": [
    "docker-compose *",
    "",
    "rasa *",
    "",
    "docker",
    "*"
  ],
  "kiroAgent.agentModelSelection": "CLAUDE_SONNET_4_20250514_V1_0",
  "terminal.integrated.commandsToSkipShell": [
    "*"
  ],
  "dart.mcpServer": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "Dart-Code.dart-code"
  },
  "explorer.confirmPasteNative": false,
  // ───────── PYTHON + LINT/TYPE ─────────
  "python.createEnvironment.trigger": "off",
  "python.defaultInterpreterPath": ".venv/bin/python",
  // Ruff: lint + format (Problems paneline düşer)
  "ruff.lint.enable": true,
  "ruff.format.enable": true,
  // Kaydettiğinde otomatik düzelt ve importları sırala
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  // Mypy: tip hataları Problems panelinde
  "mypy-type-checker.args": [
    "--config-file",
    "pyproject.toml"
  ],
  // Pylance ek denetim
  "python.analysis.typeCheckingMode": "basic",
  // Python özel formatlayıcı (Ruff)
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  // ───────── EXCLUDE AYARI ─────────
  "files.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "/Users/umitarslan/Library/Application Support/Kiro/User/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "/Users/umitarslan/Library/Application Support/Kiro/User/**": true
  }
}