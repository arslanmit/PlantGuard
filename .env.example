# PAN Skynet Analyzer Configuration
# Copy this file to .env and fill in your actual values

# PAN Firewall Configuration
PAN_FIREWALL_IP=192.168.1.1
PAN_API_KEY=your_api_key_here

# Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Output Directory
OUTPUT_DIR=./reports

# Optional: Report Format (json, text, html, all)
DEFAULT_FORMAT=all