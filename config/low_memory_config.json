{
  "experiment_name": "plantguard_low_memory",
  "experiment_description": "Low memory training configuration",
  "tags": ["low_memory", "gradient_accumulation"],
  "model_architecture": "resnet18",
  "num_classes": 38,
  "pretrained": true,
  "freeze_backbone": false,
  "dropout_rate": 0.3,
  "epochs": 10,
  "batch_size": 8,
  "learning_rate": 0.0005,
  "weight_decay": 0.0001,
  "optimizer": "adam",
  "momentum": 0.9,
  "scheduler": {
    "type": "step",
    "step_size": 5,
    "gamma": 0.1
  },
  "early_stopping": {
    "enabled": true,
    "patience": 5,
    "min_delta": 0.001,
    "monitor": "val_loss",
    "mode": "min"
  },
  "data_augmentation": {
    "enabled": true,
    "rotation": 10.0,
    "brightness": 0.1,
    "contrast": 0.1,
    "horizontal_flip": true,
    "vertical_flip": false,
    "normalize": true
  },
  "mixed_precision": true,
  "gradient_accumulation_steps": 8,
  "gradient_clip_norm": 1.0,
  "device": "auto",
  "num_workers": 0,
  "pin_memory": false,
  "persistent_workers": false,
  "train_ratio": 0.8,
  "val_ratio": 0.2,
  "random_seed": 42,
  "save_every_n_epochs": 1,
  "log_every_n_steps": 10,
  "max_checkpoints_to_keep": 2,
  "max_memory_usage_gb": 4.0
}
