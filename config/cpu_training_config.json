{
  "experiment_name": "plantguard_cpu_training",
  "experiment_description": "CPU training configuration for low-memory devices",
  "tags": ["cpu", "low_memory"],
  "model_architecture": "resnet18",
  "num_classes": 38,
  "pretrained": true,
  "freeze_backbone": true,
  "dropout_rate": 0.3,
  "epochs": 5,
  "batch_size": 8,
  "learning_rate": 0.0005,
  "weight_decay": 0.0001,
  "optimizer": "adam",
  "scheduler": {
    "type": "step",
    "step_size": 2,
    "gamma": 0.1
  },
  "early_stopping": {
    "enabled": true,
    "patience": 3,
    "min_delta": 0.001,
    "monitor": "val_loss",
    "mode": "min"
  },
  "data_augmentation": {
    "enabled": true,
    "rotation": 5.0,
    "brightness": 0.1,
    "contrast": 0.1,
    "horizontal_flip": true,
    "vertical_flip": false,
    "normalize": true
  },
  "mixed_precision": false,
  "gradient_accumulation_steps": 4,
  "gradient_clip_norm": 1.0,
  "device": "cpu",
  "num_workers": 0,
  "pin_memory": false,
  "persistent_workers": false,
  "train_ratio": 0.8,
  "val_ratio": 0.2,
  "random_seed": 42,
  "save_every_n_epochs": 1,
  "log_every_n_steps": 5,
  "max_checkpoints_to_keep": 1
}
